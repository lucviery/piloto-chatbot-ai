# Copie para .env somente quando precisar sobrescrever os valores locais.
# Nunca versione o arquivo .env nem credenciais reais.
COMPOSE_PROJECT_NAME=piloto-chatbot-ai
SMOKE_INTERNAL_PORT=8080
OLLAMA_HOST_PORT=11434
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_TIMEOUT_MS=180000
OLLAMA_NUM_PREDICT=256
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=30m
API_HOST_PORT=3000
API_PORT=3000
WEB_HOST_PORT=3001
WEB_PORT=3001
WEB_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=piloto_chatbot
POSTGRES_USER=piloto_chatbot
# Gere um valor forte e exclusivo no arquivo .env local; não use este comentário como senha.
POSTGRES_PASSWORD=
PGPOOL_MAX=5
RETENTION_DAYS=30
EMBEDDING_MODEL=embeddinggemma:latest
RAG_BASE_URL=https://dokuwiki.megaue.com.br
# Integrações da Fase 2. Preencha somente no .env local com valores do ambiente autorizado.
MEGAUE_API_BASE_URL=
MEGAUE_API_TOKEN=
MEGAUE_API_TIMEOUT_MS=15000
SUPPORT_DISCORD_WEBHOOK_URL=
SUPPORT_WEBHOOK_TIMEOUT_MS=10000
# Token forte compartilhado somente com o gateway/painel interno que encerra o atendimento humano.
INTERNAL_API_TOKEN=
