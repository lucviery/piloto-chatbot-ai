# Copie para .env somente quando precisar sobrescrever os valores locais.
# Nunca versione o arquivo .env nem credenciais reais.
COMPOSE_PROJECT_NAME=piloto-chatbot-ai
SMOKE_INTERNAL_PORT=8080
OLLAMA_HOST_PORT=11434
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_TIMEOUT_MS=180000
API_HOST_PORT=3000
API_PORT=3000
WEB_HOST_PORT=3001
WEB_PORT=3001
POSTGRES_DB=piloto_chatbot
POSTGRES_USER=piloto_chatbot
# Gere um valor forte e exclusivo no arquivo .env local; não use este comentário como senha.
POSTGRES_PASSWORD=
PGPOOL_MAX=5
RETENTION_DAYS=30
EMBEDDING_MODEL=embeddinggemma:latest
RAG_BASE_URL=https://dokuwiki.megaue.com.br
